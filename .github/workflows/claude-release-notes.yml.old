name: AI Release Notes with Claude Code

on:
  push:
    tags:
      - 'v*'

permissions:
  contents: write
  packages: write
  issues: write  # Needed to create issue for Claude
  id-token: write
  actions: read

jobs:
  prepare-release-notes:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Extract version info
        id: version
        run: |
          TAG=${GITHUB_REF#refs/tags/}
          PREV_TAG=$(git describe --tags --abbrev=0 $TAG^ 2>/dev/null || echo "")
          echo "CURRENT_TAG=$TAG" >> $GITHUB_ENV
          echo "PREV_TAG=$PREV_TAG" >> $GITHUB_ENV
          
          if [ -z "$PREV_TAG" ]; then
            RANGE="$TAG"
          else
            RANGE="$PREV_TAG..$TAG"
          fi
          echo "COMMIT_RANGE=$RANGE" >> $GITHUB_ENV

      - name: Generate commit summary
        id: commits
        run: |
          echo "## Commits for Release $CURRENT_TAG" > commit_summary.md
          echo "" >> commit_summary.md
          echo "**Previous version:** $PREV_TAG" >> commit_summary.md
          echo "**New version:** $CURRENT_TAG" >> commit_summary.md
          echo "**Repository:** $GITHUB_REPOSITORY" >> commit_summary.md
          echo "" >> commit_summary.md
          echo "### Commit History" >> commit_summary.md
          echo '```' >> commit_summary.md
          git log $COMMIT_RANGE --pretty=format:"- %s (%h) by %an" --reverse >> commit_summary.md
          echo "" >> commit_summary.md
          echo '```' >> commit_summary.md
          echo "" >> commit_summary.md
          echo "### Files Changed" >> commit_summary.md
          echo '```' >> commit_summary.md
          git diff --name-only $COMMIT_RANGE | head -20 >> commit_summary.md
          echo '```' >> commit_summary.md

      - name: Create issue for Claude to process
        id: create-issue
        uses: actions/github-script@v7
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            const fs = require('fs');
            const commitSummary = fs.readFileSync('commit_summary.md', 'utf8');
            
            const issueBody = `@claude Please generate professional release notes for version ${process.env.CURRENT_TAG}.

            ${commitSummary}

            **Instructions:**
            1. Transform technical commit messages into user-friendly descriptions
            2. Focus on user benefits and impact, not implementation details
            3. Group related changes logically
            4. Use these emoji categories:
               - 🚀 **New Features** - New functionality users can access
               - 🐛 **Bug Fixes** - Issues that have been resolved
               - ⚡ **Performance** - Speed and efficiency improvements  
               - 📚 **Documentation** - Updated guides, docs, examples
               - 🔧 **Maintenance** - Dependencies, internal improvements
               - 💥 **Breaking Changes** - Changes that might break existing usage

            5. Include commit links in format: ([abc1234](https://github.com/${process.env.GITHUB_REPOSITORY}/commit/FULL_HASH))
            6. Start with "## What's Changed"
            7. If there are breaking changes, highlight them prominently
            8. Keep descriptions concise but informative
            9. Focus on what users can now do or what problems are solved

            Please generate the release notes and I'll use them to create the GitHub release.`;

            const { data: issue } = await github.rest.issues.create({
              owner: context.repo.owner,
              repo: context.repo.repo,
              title: `🤖 Generate Release Notes for ${process.env.CURRENT_TAG}`,
              body: issueBody,
              labels: ['release-notes', 'claude-task']
            });

            console.log(`Created issue: ${issue.html_url}`);
            return issue.number;

      - name: Wait for Claude response
        id: wait-response
        uses: actions/github-script@v7
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            const issueNumber = ${{ steps.create-issue.outputs.result }};
            
            // Wait for Claude to respond (check every 30 seconds for up to 5 minutes)
            let attempts = 0;
            const maxAttempts = 10;
            
            while (attempts < maxAttempts) {
              const { data: comments } = await github.rest.issues.listComments({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: issueNumber
              });
              
              // Look for Claude's response (from github-actions bot or specific pattern)
              const claudeResponse = comments.find(comment => 
                comment.user.login === 'github-actions[bot]' && 
                comment.body.includes('## What\'s Changed')
              );
              
              if (claudeResponse) {
                console.log('Found Claude response');
                
                // Extract release notes from Claude's response
                const releaseNotes = claudeResponse.body;
                
                // Store for next job
                core.setOutput('release-notes', releaseNotes);
                
                // Close the issue
                await github.rest.issues.update({
                  owner: context.repo.owner,
                  repo: context.repo.repo,
                  issue_number: issueNumber,
                  state: 'closed'
                });
                
                return releaseNotes;
              }
              
              attempts++;
              console.log(`Attempt ${attempts}/${maxAttempts} - waiting for Claude response...`);
              await new Promise(resolve => setTimeout(resolve, 30000)); // Wait 30 seconds
            }
            
            // Fallback if Claude doesn't respond
            console.log('Claude did not respond in time, using fallback');
            return `## What's Changed\n\nRelease ${process.env.CURRENT_TAG} includes various improvements and fixes.\n\n**Full Changelog**: https://github.com/${context.repo.owner}/${context.repo.repo}/compare/${process.env.COMMIT_RANGE.replace('..', '...')}`;

  claude:
    # This is your existing Claude Code job, slightly modified
    needs: prepare-release-notes
    if: contains(github.event.issue.body, '@claude') || contains(github.event.issue.title, 'Generate Release Notes')
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: read
      issues: write  # Changed from read to write so Claude can respond
      id-token: write
      actions: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Run Claude Code
        id: claude
        uses: anthropics/claude-code-action@beta
        with:
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          additional_permissions: |
            actions: read
          custom_instructions: |
            You are helping generate release notes for software releases.
            Focus on user impact and benefits rather than technical implementation details.
            Create professional, clear, and compelling release notes that help users understand what's new and improved.

  create-release:
    needs: [prepare-release-notes, claude]
    runs-on: ubuntu-latest
    steps:
      - name: Create GitHub Release
        uses: actions/github-script@v7
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            const tag = process.env.CURRENT_TAG;
            const isPrerelease = tag.includes('-');
            
            // Get release notes from previous job or use fallback
            const releaseNotes = "${{ needs.prepare-release-notes.outputs.release-notes }}" || 
              `## What's Changed\n\nRelease ${tag} includes various improvements and fixes.`;
            
            await github.rest.repos.createRelease({
              owner: context.repo.owner,
              repo: context.repo.repo,
              tag_name: tag,
              name: `Release ${tag}`,
              body: releaseNotes,
              draft: true,  // Create as draft for final review
              prerelease: isPrerelease
            });

  # Your existing publish job would go here after the release is manually published