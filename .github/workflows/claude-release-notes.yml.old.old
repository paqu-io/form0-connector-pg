name: Generate Release Notes

on:
  push:
    tags:
      - 'v*'

permissions:
  contents: write
  issues: write

jobs:
  prepare-release:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Extract version and commits
        id: version
        run: |
          TAG=${GITHUB_REF#refs/tags/}
          PREV_TAG=$(git describe --tags --abbrev=0 $TAG^ 2>/dev/null || echo "")
          
          echo "CURRENT_TAG=$TAG" >> $GITHUB_ENV
          echo "PREV_TAG=$PREV_TAG" >> $GITHUB_ENV
          
          if [ -z "$PREV_TAG" ]; then
            RANGE="$TAG"
            echo "This is the first release"
          else
            RANGE="$PREV_TAG..$TAG"
            echo "Comparing $PREV_TAG to $TAG"
          fi
          
          echo "COMMIT_RANGE=$RANGE" >> $GITHUB_ENV

      - name: Create issue for Claude
        id: create-issue
        uses: actions/github-script@v7
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            const { execSync } = require('child_process');
            
            // Get commit data
            const range = process.env.COMMIT_RANGE;
            const currentTag = process.env.CURRENT_TAG;
            const prevTag = process.env.PREV_TAG || 'initial commit';
            
            let commits = [];
            let filesChanged = [];
            
            try {
              const commitOutput = execSync(`git log ${range} --pretty=format:"- %s (%h) by %an" --reverse`).toString().trim();
              commits = commitOutput.split('\n').filter(line => line.trim());
              
              const filesOutput = execSync(`git diff --name-only ${range} 2>/dev/null || echo ""`).toString().trim();
              filesChanged = filesOutput.split('\n').filter(line => line.trim()).slice(0, 15);
            } catch (error) {
              console.log('Error getting git data:', error.message);
              commits = ['- Release preparation'];
              filesChanged = [];
            }
            
            const issueBody = `@claude Please generate professional release notes for version **${currentTag}**.

            ## Release Information
            - **Previous version:** ${prevTag}
            - **New version:** ${currentTag}
            - **Repository:** ${context.repo.owner}/${context.repo.repo}
            - **Total commits:** ${commits.length}

            ## Commit History
            \`\`\`
            ${commits.join('\n')}
            \`\`\`

            ${filesChanged.length > 0 ? `## Files Changed
            \`\`\`
            ${filesChanged.join('\n')}
            \`\`\`` : ''}

            ## Instructions for Release Notes
            1. **Transform technical commits into user-friendly descriptions**
            2. **Focus on user benefits and impact**, not implementation details
            3. **Group related changes logically**
            4. **Use these emoji categories:**
               - 🚀 **New Features** - New functionality users can access
               - 🐛 **Bug Fixes** - Issues that have been resolved
               - ⚡ **Performance** - Speed and efficiency improvements
               - 📚 **Documentation** - Updated guides, docs, examples
               - 🔧 **Maintenance** - Dependencies, internal improvements
               - 💥 **Breaking Changes** - Changes that might break existing usage

            5. **Include commit links** in format: ([abc1234](https://github.com/${context.repo.owner}/${context.repo.repo}/commit/FULL_HASH))
            6. **Start with "## What's Changed"**
            7. **If there are breaking changes, highlight them prominently**
            8. **Keep descriptions concise but informative**
            9. **Focus on what users can now do or what problems are solved**

            Please generate the release notes in your response. Once you reply, I'll copy your response to update the draft release that's being created.

            Thanks! 🚀`;

            const { data: issue } = await github.rest.issues.create({
              owner: context.repo.owner,
              repo: context.repo.repo,
              title: `🤖 Generate Release Notes for ${currentTag}`,
              body: issueBody,
              labels: ['release-notes', 'claude-task']
            });

            console.log(`✅ Created issue for Claude: ${issue.html_url}`);
            core.setOutput('issue-url', issue.html_url);
            core.setOutput('issue-number', issue.number);

      - name: Create draft release
        uses: actions/github-script@v7
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            const tag = process.env.CURRENT_TAG;
            const prevTag = process.env.PREV_TAG || 'initial';
            const isPrerelease = tag.includes('-');
            const issueUrl = '${{ steps.create-issue.outputs.issue-url }}';
            
            const placeholderBody = `## 🤖 AI-Generated Release Notes

            **Status:** ⏳ Claude is generating professional release notes for this release.

            **Instructions:**
            1. ✅ Claude will respond in this issue: ${issueUrl}
            2. ✅ Copy Claude's response from the issue
            3. ✅ Edit this release and paste the response in the body
            4. ✅ Review/edit as needed
            5. ✅ Click "Publish release" when ready
            6. ✅ Your publish workflow will automatically run

            ---

            ### Quick Summary
            Release **${tag}** with ${process.env.COMMIT_RANGE.includes('..') ? 'updates since ' + prevTag : 'initial features'}.

            **Full Changelog:** https://github.com/${context.repo.owner}/${context.repo.repo}/compare/${prevTag}...${tag}

            ---
            
            *🔄 Replace this placeholder text with Claude's response from the issue above.*`;

            const { data: release } = await github.rest.repos.createRelease({
              owner: context.repo.owner,
              repo: context.repo.repo,
              tag_name: tag,
              name: `${tag}`,
              body: placeholderBody,
              draft: true,
              prerelease: isPrerelease
            });

            console.log(`✅ Created draft release: ${release.html_url}`);
            console.log(`📝 Next steps:`);
            console.log(`   1. Wait for Claude to respond in: ${issueUrl}`);
            console.log(`   2. Copy Claude's response`);
            console.log(`   3. Edit the draft release: ${release.html_url}`);
            console.log(`   4. Publish when ready!`);