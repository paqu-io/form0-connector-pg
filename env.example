# PostgreSQL Connection Settings
FORM0_PG_HOST=localhost
FORM0_PG_PORT=5432
FORM0_PG_DATABASE=your_database_name
FORM0_PG_USERNAME=your_username
FORM0_PG_PASSWORD=your_password

# Optional: SSL Configuration
FORM0_PG_SSL=false
FORM0_PG_SSL_REJECT_UNAUTHORIZED=true

# Optional: Connection Pool Settings
FORM0_PG_MAX_CONNECTIONS=10
FORM0_PG_IDLE_TIMEOUT=30000
FORM0_PG_CONNECTION_TIMEOUT=5000

# Optional: Table Configuration
FORM0_PG_TABLE_NAME=form_submissions
FORM0_PG_SCHEMA=public

# Optional: Logging
FORM0_PG_DEBUG=false